# capture environment template. Copy, edit, then `source .env` in your shell.
# The binary reads the process environment only; loading this file is your job.

# Vault root directory. Required: capture fails when unset or not an existing directory.
export CAPTURE_VAULT=/home/you/vault/MyVault

# Subfolder inside the vault for daily notes. Unset = vault root; set but missing = fail (never auto-created).
export CAPTURE_DAILY_DIR=Journal

# Daily note filename as a Go time layout, default 2006-01-02 (NOT strftime: %Y-%m-%d is invalid and fails).
export CAPTURE_DAILY_FORMAT=2006-01-02
